# infra/stacks/gcp/versions.tf
#
# Terraform + provider version pins for the GCP stack (mirrors the AWS stack).

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.40"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}
