# Idea Board — environment configuration example.
#
# Copy to `.env` (which is gitignored) and adjust as needed:
#   cp .env.example .env
#
# docker-compose.yml reads these values; every one has a sane default baked in,
# so an unmodified copy works out of the box for local development.

# ---------------------------------------------------------------------------
# Database (Postgres 16 container `db`)
# ---------------------------------------------------------------------------
POSTGRES_USER=ideas
POSTGRES_PASSWORD=ideas
POSTGRES_DB=ideas

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
# SQLAlchemy 2.x + psycopg (v3) connection string.
# Form: postgresql+psycopg://USER:PASS@HOST:PORT/DBNAME
# `db` is the compose service name; use localhost:5432 if running natively.
DATABASE_URL=postgresql+psycopg://ideas:ideas@db:5432/ideas

# Comma-separated list of origins allowed by CORS. For local dev this is the
# published frontend origin below.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend (React + Vite, served by nginx)
# ---------------------------------------------------------------------------
# Base URL the browser uses to reach the API. Baked in at Vite build time.
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# AI features (optional, only needed to run the ai/* tooling locally)
# ---------------------------------------------------------------------------
# Anthropic API key used by ai/healthcheck, ai/envgen, ai/explain.
# The LLM never receives cloud credentials. Leave blank unless you run them.
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Deploy targets (used by the Makefile; not read by docker compose)
# ---------------------------------------------------------------------------
# Target cloud for `make tf-init|deploy|destroy`. One of: aws | gcp
# CLOUD=aws
